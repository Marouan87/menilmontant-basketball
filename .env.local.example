# Envoi du formulaire de contact (Resend)
# Créer la clé sur https://resend.com/api-keys puis la renseigner ici en local
# et dans les variables d'environnement du projet Vercel.
RESEND_API_KEY=

# Destinataire des messages. Par défaut, l'adresse du club definie dans content/site.js
CONTACT_TO=menil.parissports@gmail.com

# Expéditeur. Tant que le domaine du club n'est pas vérifié dans Resend,
# laisser l'expéditeur de test ci-dessous.
CONTACT_FROM=Site du club <onboarding@resend.dev>
